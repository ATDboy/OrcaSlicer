#!/bin/bash

REQUIRED_DEV_PACKAGES=(
    autoconf
    build-essential
    cmake
    eglexternalplatform-dev
    extra-cmake-modules
    file
    g++
    gettext
    git
    gstreamer1.0-gtk3
    libcurl4-openssl-dev
    libdbus-1-dev
    libglew-dev
    libgstreamerd-3-dev
    libgtk-3-dev
    libmspack-dev
    libsecret-1-dev
    libspnav-dev
    libssl-dev
    libtool
    libudev-dev
    clang
    lld
    ninja-build
    texinfo
    wget
)

if [[ -n "$UPDATE_LIB" ]]
then
    # shellcheck source=/dev/null
    source /etc/os-release
    if [ "${ID}" == "ubuntu" ] && [ -n "${VERSION_ID}" ]; then
        # It's ubuntu and we have a VERSION_ID like "24.04".
        if dpkg --compare-versions "${VERSION_ID}" ge 22 && dpkg --compare-versions "${VERSION_ID}" lt 24 ;
        then
            # Some extra packages needed on Ubuntu 22.x and 23.x:
            REQUIRED_DEV_PACKAGES+=(curl libfuse-dev m4)
        fi
    fi

    if [[ -n "$BUILD_DEBUG" ]]
    then
        REQUIRED_DEV_PACKAGES+=(libssl-dev libcurl4-openssl-dev)
    fi

    # Install the webkit2gtk ABI the build actually requires. src/slic3r/CMakeLists.txt has
    # an unconditional pkg_check_modules(webkit2gtk REQUIRED webkit2gtk-4.1), so preferring
    # 4.0 where both exist - Ubuntu 22.04, Debian 12 - fails at configure time. Taking 4.1
    # also keeps the resulting binary loadable on Arch, Fedora and Debian 13, which dropped
    # 4.0 entirely; the AppImage resolves webkit from the host rather than bundling it.
    if [ "$(apt show --quiet libwebkit2gtk-4.1-dev 2>/dev/null)" != "" ]
    then
        REQUIRED_DEV_PACKAGES+=(libwebkit2gtk-4.1-dev)
    else
        echo "Warning: libwebkit2gtk-4.1-dev is unavailable; falling back to 4.0, which this" \
             "version of OrcaSlicer does not build against." >&2
        REQUIRED_DEV_PACKAGES+=(libwebkit2gtk-4.0-dev)
    fi

    # install them all at once
    sudo apt update
    sudo apt install -y "${REQUIRED_DEV_PACKAGES[@]}"

    echo -e "done\n"
    exit 0
fi

export FOUND_GTK3_DEV
FOUND_GTK3_DEV=$(dpkg -l libgtk* | grep gtk-3-dev || echo '')
